{
	"name": "dave-factory-tycoon",
	"build": {
		"dockerfile": "Dockerfile"
	},

	"mounts": ["source=${localEnv:HOME}/.ssh,target=/home/bun/.ssh,type=bind,consistency=cached"],

	"customizations": {
		"vscode": {
			"extensions": [
				"roblox-ts.vscode-roblox-ts",
				"evaera.vscode-rojo",
				"muoshuu.rojo-ui",
				"nightrains.robloxlsp",
				"otadtoad.rblx-react-lsp",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"oven.bun-vscode",
				"ms-vscode.vscode-typescript-next",
				"github.copilot-chat",
				"github.vscode-pull-request-github"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "fish",
				"terminal.integrated.profiles.linux": {
					"fish": {
						"path": "/usr/bin/fish"
					}
				},
				"typescript.tsdk": "node_modules/typescript/lib",
				"files.eol": "\n",
				"[typescript]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint",
					"editor.formatOnSave": true
				},
				"[typescriptreact]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint",
					"editor.formatOnSave": true
				},
				"eslint.run": "onType",
				"eslint.format.enable": true,
				"eslint.useFlatConfig": false
			}
		}
	},

	"postCreateCommand": "bun install",
	"postStartCommand": "/bin/sh .devcontainer/start-services.sh",

	"remoteUser": "bun"
}
